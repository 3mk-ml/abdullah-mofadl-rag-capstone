# Choose: cohere, groq, gemini, or openai
LLM_PROVIDER=cohere

# Recommended free/trial option for the capstone RAGAS run
COHERE_API_KEY=your_cohere_key_here
COHERE_MODEL=command-a-plus-05-2026
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1
RAGAS_EVALUATOR_MODEL=command-a-plus-05-2026
RAGAS_MAX_TOKENS=4096

# Optional Hugging Face authentication. Public models work without it.
HF_TOKEN=

# Alternative Groq provider
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Alternative Gemini provider
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Alternative OpenAI provider
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5.6-luna

APP_PASSWORD=change-me
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CHUNK_SIZE=350
CHUNK_OVERLAP=60
VECTOR_K=20
BM25_K=20
RERANK_TOP_N=5
RRF_K=60
