# Choose: groq, gemini, or openai
LLM_PROVIDER=groq

# Recommended free-tier option for this capstone
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
RAGAS_MAX_TOKENS=900

# Optional Hugging Face authentication. Public models work without it.
HF_TOKEN=

# Alternative Gemini provider
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Alternative OpenAI provider
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5.6-luna

APP_PASSWORD=change-me
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CHUNK_SIZE=350
CHUNK_OVERLAP=60
VECTOR_K=20
BM25_K=20
RERANK_TOP_N=5
RRF_K=60
